---
import '@fontsource-variable/open-sans'
import '@fortawesome/fontawesome-svg-core/styles.css'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import Footer from '../components/Footer.astro'
import Navbar from '../components/Navbar.astro'
import { SITE_COLOR, SITE_DESCRIPTION, SITE_TITLE, SOCIAL } from '../consts'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  canonical?: string
  type?: 'website' | 'article' | 'profile'
  image?: ImageMetadata
  article?: {
    publishedTime: Date
    section: string
    authors: string[]
    tags: string[]
  }
  profile?: { username: string }
  /** schema.org objects serialized as JSON-LD. */
  jsonLd?: object[]
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  type = 'website',
  image,
  article,
  profile,
  jsonLd = [],
} = Astro.props

const canonical =
  Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href
const ogImage = image
  ? new URL(
      (
        await getImage({
          src: image,
          width: 1200,
          format: 'jpg',
          layout: 'none',
        })
      ).src,
      Astro.site
    ).href
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.publishedTime.toISOString()}
        />
        <meta
          property="article:modified_time"
          content={article.publishedTime.toISOString()}
        />
        <meta property="article:section" content={article.section} />
        {article.authors.map(author => (
          <meta property="article:author" content={author} />
        ))}
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    {profile && <meta property="profile:username" content={profile.username} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${SOCIAL.twitter}`} />

    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      href="/img/favicon-32x32.png"
      sizes="32x32"
    />
    <link
      rel="icon"
      type="image/png"
      href="/img/favicon-16x16.png"
      sizes="16x16"
    />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="theme-color" content={SITE_COLOR} />
    <meta name="msapplication-navbutton-color" content={SITE_COLOR} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="msapplication-TileColor" content={SITE_COLOR} />

    {jsonLd.map(data => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(data)}
      />
    ))}

    <script
      is:inline
      async
      src="https://a.data-show.com/js/pa-sb1uL67sH90hkcRBq4dr2.js"
    ></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          ;(plausible.q = plausible.q || []).push(arguments)
        }
      plausible.init =
        plausible.init ||
        function (i) {
          plausible.o = i || {}
        }
      plausible.init({ endpoint: 'https://a.data-show.com/api/event' })
    </script>
  </head>
  <body>
    <div class="max-w-screen-lg mx-auto antialiased">
      <Navbar />

      <main class="mt-4 lg:mt-12">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
