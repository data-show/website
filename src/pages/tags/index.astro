---
import { SITE_TITLE } from '../../consts'
import Layout from '../../layouts/Layout.astro'
import { getTags, tagUrl } from '../../lib/content'

const tags = (await getTags()).sort((a, b) => a.tag.localeCompare(b.tag))
---

<Layout title={`Tags | ${SITE_TITLE}`} description="List of tags">
  <section class="max-w-3xl mx-auto px-2 sm:px-4 xl:max-w-5xl xl:px-0">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Tags</h1>
    <ul>
      {tags.map(({ tag, posts, dataviz }) => (
        <li class="mb-2">
          <a href={tagUrl(tag)} class="underline">
            {tag} ({posts.length + dataviz.length})
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
