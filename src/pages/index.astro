---
import DataVizPostCard from '../components/DataVizPostCard.astro'
import OptimizedImage from '../components/OptimizedImage.astro'
import Layout from '../layouts/Layout.astro'
import { getDataviz, getPosts, postUrl } from '../lib/content'

const [first, ...others] = (await getPosts()).slice(0, 5)
const dataviz = (await getDataviz()).slice(0, 3)
---

<Layout>
  {first && (
    <div class="lg:flex space-x-0 lg:space-x-6 mb-16">
      <div class="mb-4 lg:mb-0 p-4 lg:p-0 w-full lg:w-1/2 rounded block">
        <a href={postUrl(first)}>
          <OptimizedImage
            src={first.data.featuredimage}
            alt={first.data.title}
            title={first.data.title}
            width={512}
            widths={[480, 640, 960, 1280]}
            sizes="(min-width: 1024px) 496px, 100vw"
            priority
            class="rounded-md object-cover w-full h-64"
          />
        </a>
        <span class="text-gray-700 text-sm hidden lg:block mt-4">
          {first.data.category}
        </span>
        <a href={postUrl(first)}>
          <h2 class="text-gray-800 text-xl lg:text-4xl font-bold mt-2 mb-2 leading-tight">
            {first.data.title}
          </h2>
        </a>
        <p class="text-gray-600 mb-4">{first.data.description}</p>
        <a
          href={postUrl(first)}
          class="inline-block px-6 py-3 mt-2 rounded-md bg-gray-700 text-gray-100"
        >
          Read more
        </a>
      </div>

      <div class="w-full lg:w-1/2">
        {others.map(post => (
          <div class="rounded w-full flex flex-col lg:flex-row mb-10">
            <a href={postUrl(post)} class="shrink-0">
              <OptimizedImage
                src={post.data.featuredimage}
                alt={post.data.title}
                title={post.data.title}
                width={350}
                height={128}
                widths={[350, 700, 960]}
                sizes="(min-width: 1024px) 350px, 100vw"
                class="block rounded-md h-32 w-full lg:w-auto object-cover m-4 lg:m-0"
              />
            </a>
            <div class="bg-white rounded px-4">
              <span class="text-gray-700 text-sm hidden lg:block">
                {post.data.category}
              </span>
              <a href={postUrl(post)}>
                <h3 class="lg:mt-0 text-gray-800 font-semibold text-lg lg:text-xl mb-2">
                  {post.data.title}
                </h3>
              </a>
              <p class="block lg:hidden p-2 pl-0 pt-1 text-sm text-gray-600">
                {post.data.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {dataviz.length > 0 && (
    <section>
      <div class="flex mt-8 lg:mt-16 mb-8 px-4 lg:px-0 items-center justify-between">
        <h2 class="font-bold text-xl lg:text-3xl">Latest DataViz</h2>
        <a
          href="/dataviz/"
          class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded cursor-pointer"
        >
          View all
        </a>
      </div>
      <div class="block space-x-0 lg:flex lg:space-x-6">
        {dataviz.map(item => (
          <DataVizPostCard
            class="lg:w-1/3 p-4 lg:p-0"
            slug={postUrl(item)}
            title={item.data.title}
            image={item.data.media}
          />
        ))}
      </div>
    </section>
  )}
</Layout>
