---
import { render } from 'astro:content'
import { format } from 'date-fns'
import getReadingTime from 'reading-time'

import BlogPostCard from '../../components/BlogPostCard.astro'
import DataVizPostCard from '../../components/DataVizPostCard.astro'
import NewsletterForm from '../../components/NewsletterForm.astro'
import OptimizedImage from '../../components/OptimizedImage.astro'
import ShareButtons from '../../components/ShareButtons.astro'
import TagList from '../../components/TagList.astro'
import Layout from '../../layouts/Layout.astro'
import {
  authorUrl,
  categoryUrl,
  getAuthor,
  getCategory,
  getDataviz,
  getPosts,
  postUrl,
} from '../../lib/content'
import { absoluteImageUrl } from '../../lib/images'
import { article, breadcrumb } from '../../lib/jsonld'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)

const { title, description, tags, sources, notebooks } = post.data
const site = Astro.site!
const url = new URL(postUrl(post), site).href
const [author, category, lastPosts, lastDataviz] = await Promise.all([
  getAuthor(post.data.author),
  getCategory(post.data.category),
  getPosts().then(posts =>
    posts.filter(({ id }) => id !== post.id).slice(0, 3)
  ),
  getDataviz().then(dataviz => dataviz.slice(0, 3)),
])
const image = await absoluteImageUrl(post.data.featuredimage, site)
const readingTime = Math.ceil(getReadingTime(post.body ?? '').minutes)
---

<Layout
  title={title}
  description={description}
  canonical={post.data.canonical ?? url}
  type="article"
  image={post.data.featuredimage}
  article={{
    publishedTime: post.data.date,
    section: category.data.title,
    authors: [new URL(authorUrl(author), site).href],
    tags,
  }}
  jsonLd={[
    article({
      type: 'BlogPosting',
      url,
      headline: title,
      image,
      datePublished: post.data.date,
      authorName: author.data.name,
      description,
      site,
    }),
    breadcrumb([
      { name: 'Home', url: new URL('/', site).href },
      {
        name: category.data.title,
        url: new URL(categoryUrl(category), site).href,
      },
      { name: title, url },
    ]),
  ]}
>
  <article class="max-w-2xl mx-auto px-4 sm:px-6 xl:max-w-4xl xl:px-0">
    <header class="pt-2 pb-2 xl:pb-4 lg:border-b-2 lg:border-gray-200">
      <OptimizedImage
        src={post.data.featuredimage}
        alt={title}
        title={title}
        width={896}
        widths={[480, 640, 960, 1280, 1792]}
        sizes="(min-width: 1280px) 896px, (min-width: 672px) 672px, 100vw"
        priority
        class="rounded-md object-cover w-full h-64 lg:h-96 mb-4 lg:mb-8"
      />
      <div class="space-y-4 text-left">
        <a href="#sources" class="underline">
          Sources
        </a>{' '}
        <a href="#notebooks" class="underline">
          Notebooks
        </a>
        <h1 class="text-3xl leading-12 text-gray-800 lg:text-4xl lg:leading-14 mb-2">
          {title}
        </h1>
        <p class="text-lg leading-6 text-gray-600 lg:text-xl lg:leading-8 mb-4">
          {description}
        </p>
        <div class="grid grid-cols-4 gap-2 py-2">
          <div class="col-span-4 lg:col-span-3 flex">
            <a class="text-gray-900 leading-none" href={authorUrl(author)}>
              <OptimizedImage
                src={author.data.image}
                alt={author.data.name}
                width={40}
                height={40}
                widths={[40, 80, 120]}
                sizes="40px"
                class="w-10 h-10 rounded-full mr-4 object-cover"
              />
            </a>
            <div class="text-sm">
              <a class="text-gray-900 leading-none" href={authorUrl(author)}>
                {author.data.name}
              </a>
              <p class="text-gray-600">
                <span>{format(post.data.date, 'PP')}</span> -{' '}
                <span>{`${readingTime} minute${readingTime > 1 ? 's' : ''} read`}</span>
              </p>
            </div>
          </div>

          <ShareButtons
            url={url}
            title={title}
            description={description}
            tags={tags}
            authorTwitter={author.data.twitter}
          />
        </div>
      </div>
    </header>

    <div class="mt-6 mb-2">
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </div>

    <div class="mt-6 mb-2">
      <div class="my-4 lg:my-8" id="sources">
        <h2 class="font-bold text-xl mb-2">Sources</h2>

        <hr class="my-4" />

        {sources.length > 0 ? (
          sources.map(source => (
            <a
              class="underline mr-4"
              href={source.link}
              target="_blank"
              rel="noopener nofollow"
            >
              {source.source ?? source.link}
            </a>
          ))
        ) : (
          <span>There is no sources for this article.</span>
        )}
      </div>

      <div class="my-4 lg:my-8" id="notebooks">
        <h2 class="font-bold text-xl mb-2">Notebooks</h2>

        <hr class="my-4" />

        {notebooks.length > 0 ? (
          notebooks.map(notebook => (
            <a class="underline mr-4" href={notebook.link} target="_blank">
              {notebook.title}
            </a>
          ))
        ) : (
          <span>There is no notebooks for this article.</span>
        )}
      </div>

      <section class="my-8 lg:my-12 mx-auto bg-gray-700 p-6 w-full lg:w-3/4">
        <p class="font-bold text-white text-lg mb-4">
          Did you find this article interesting ? Subscribe to the newsletter.
        </p>
        <NewsletterForm />
      </section>

      <section class="mt-8">
        <h3 class="font-bold text-xl mb-2">Latest Posts</h3>

        <hr class="my-4" />

        <div class="block space-x-0 lg:flex lg:space-x-6">
          {lastPosts.map(item => (
            <BlogPostCard
              class="mx-4"
              slug={postUrl(item)}
              title={item.data.title}
              image={item.data.featuredimage}
            />
          ))}
        </div>
      </section>

      <section class="mt-8">
        <div class="flex mb-2 px-4 lg:px-0 items-center justify-between">
          <h2 class="font-bold text-xl">Latest DataViz</h2>
          <a
            href="/dataviz/"
            class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded cursor-pointer"
          >
            View all
          </a>
        </div>

        <hr class="my-4" />

        <div class="block space-x-0 lg:flex lg:space-x-6">
          {lastDataviz.map(item => (
            <DataVizPostCard
              class="lg:w-1/3 p-4 lg:p-0"
              slug={postUrl(item)}
              title={item.data.title}
              image={item.data.media}
            />
          ))}
        </div>
      </section>

      <TagList tags={tags} class="my-4 lg:my-8" />
    </div>
  </article>
</Layout>
