---
import DataVizPostCard from '../../components/DataVizPostCard.astro'
import { SITE_TITLE } from '../../consts'
import Layout from '../../layouts/Layout.astro'
import { getDataviz, postUrl } from '../../lib/content'

const dataviz = await getDataviz()
---

<Layout title={`DataViz | ${SITE_TITLE}`} description="List of dataViz">
  <section class="max-w-3xl mx-auto px-2 sm:px-4 xl:max-w-5xl xl:px-0">
    <div class="space-y-4 text-left py-2 mb-6 lg:mb-8">
      <h1 class="text-3xl leading-9 text-gray-800 sm:text-4xl sm:leading-10 lg:text-5xl lg:leading-14 mb-2">
        DataViz
      </h1>
    </div>

    <div class="grid xs:grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {dataviz.map(item => (
        <DataVizPostCard
          title={item.data.title}
          slug={postUrl(item)}
          image={item.data.media}
        />
      ))}
    </div>
  </section>
</Layout>
