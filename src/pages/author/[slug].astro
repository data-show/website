---
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons'

import BlogPostCard from '../../components/BlogPostCard.astro'
import Icon from '../../components/Icon.astro'
import OptimizedImage from '../../components/OptimizedImage.astro'
import Layout from '../../layouts/Layout.astro'
import { getAuthors, getPosts, postUrl } from '../../lib/content'

export async function getStaticPaths() {
  const authors = await getAuthors()
  return authors.map(author => ({
    params: { slug: author.id },
    props: { author },
  }))
}

const { author } = Astro.props
const { name, description, username, image, website, github, linkedin } =
  author.data

const posts = (await getPosts()).filter(({ data }) => data.author === username)

const linkClass = 'block flex items-center hover:text-gray-700 mr-5'
---

<Layout
  title={name}
  description={description}
  type="profile"
  image={image}
  profile={{ username }}
>
  <section class="max-w-3xl mx-auto px-2 sm:px-4 xl:max-w-5xl xl:px-0">
    <section>
      <div class="space-y-4 text-left py-2 mb-6 lg:mb-8">
        <div class="grid grid-cols-6 gap-2 py-2">
          <div class="col-span-6 lg:col-span-4 flex">
            <div>
              <h1 class="text-3xl leading-9 text-gray-800 sm:text-4xl sm:leading-10 lg:text-5xl lg:leading-14 mb-2">
                {name}
              </h1>
              <p class="text-lg text-gray-600 prose lg:prose-lg lg:leading-8 mb-4">
                {description}
              </p>
              <div class="flex justify-start items-center text-lg text-gray-500">
                {website && (
                  <a
                    class={linkClass}
                    href={website}
                    target="_blank"
                    rel="noopener"
                  >
                    {website}
                  </a>
                )}
                {github && (
                  <a
                    class={linkClass}
                    href={`https://github.com/${github}`}
                    target="_blank"
                    rel="noopener nofollow"
                    aria-label="GitHub"
                  >
                    <Icon icon={faGithub} />
                  </a>
                )}
                {linkedin && (
                  <a
                    class={linkClass}
                    href={linkedin}
                    target="_blank"
                    rel="noopener nofollow"
                    aria-label="LinkedIn"
                  >
                    <Icon icon={faLinkedin} />
                  </a>
                )}
              </div>
            </div>
          </div>

          <OptimizedImage
            src={image}
            alt={name}
            width={300}
            height={300}
            class="rounded-full ml-4 object-cover"
          />
        </div>

        <div class="flex mt-16 mb-4 px-4 lg:px-0 items-center justify-between">
          <h2 class="font-bold text-3xl">Latest</h2>
        </div>

        <div class="grid xs:grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <BlogPostCard
              slug={postUrl(post)}
              title={post.data.title}
              description={post.data.description}
              image={post.data.featuredimage}
            />
          ))}
        </div>
      </div>
    </section>
  </section>
</Layout>
