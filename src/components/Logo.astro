---
import logo from '../assets/logo.png'
import OptimizedImage from './OptimizedImage.astro'

interface Props {
  title: string
  class?: string
}

const { title, class: className } = Astro.props
---

<OptimizedImage
  src={logo}
  alt={title}
  title={title}
  class={className}
  width={50}
  height={50}
  widths={[50, 100, 150]}
  sizes="50px"
  loading="eager"
/>
