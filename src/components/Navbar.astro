---
import { SITE_TITLE } from '../consts'
import { categoryUrl, getCategories } from '../lib/content'

import Logo from './Logo.astro'

const categories = await getCategories()
---

<header class="flex items-center justify-between py-2">
  <a href="/" class="px-2 lg:px-0">
    <Logo title={SITE_TITLE} />
  </a>
  <ul class="hidden lg:inline-flex items-center">
    {categories.map(category => (
      <li class="px-2 lg:px-4">
        <a
          href={categoryUrl(category)}
          class="text-gray-500 font-semibold hover:text-gray-700"
        >
          {category.data.title}
        </a>
      </li>
    ))}
    <li class="px-2 lg:px-4">
      <a
        href="/dataviz/"
        class="text-gray-500 font-semibold hover:text-gray-700"
      >
        DataViz
      </a>
    </li>
  </ul>
</header>
