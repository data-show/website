---
import {
  faGithub,
  faInstagram,
  faLinkedin,
  faTwitter,
  faYoutube,
} from '@fortawesome/free-brands-svg-icons'
import { faRss } from '@fortawesome/free-solid-svg-icons'

import { SITE_DESCRIPTION, SOCIAL } from '../consts'
import { categoryUrl, getCategories } from '../lib/content'

import Icon from './Icon.astro'
import NewsletterForm from './NewsletterForm.astro'

const { twitter, instagram, youtube, github, linkedin } = SOCIAL
const categories = await getCategories()

const linkClass = 'flex items-center hover:text-gray-700 mr-5'
---

<footer class="border-t mt-4 lg:mt-12 py-2 lg:py-12 px-4 lg:px-0">
  <div class="flex flex-wrap">
    <div class="w-full lg:w-2/5">
      <h6 class="font-semibold text-gray-700 mb-4">Project</h6>
      <p class="text-gray-600 block p-0 lg:pr-12">{SITE_DESCRIPTION}</p>
    </div>

    <div class="w-full mt-6 lg:mt-0 lg:w-1/2 lg:w-1/5">
      <h6 class="font-semibold text-gray-700 mb-4">Content</h6>
      <ul>
        {categories.map(category => (
          <li>
            <a href={categoryUrl(category)} class="block text-gray-600 py-2">
              {category.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="w-full mt-6 lg:mt-0 lg:w-1/2 lg:w-2/5">
      <div class="bg-gray-700 p-4 mb-4 w-max">
        <h6 class="font-semibold text-white mb-4">Newsletter</h6>
        <NewsletterForm />
      </div>

      <div class="p-4">
        <h6 class="font-semibold text-gray-700 mb-4">Social</h6>
        <ul>
          <li>
            <div class="flex justify-start items-center text-lg text-gray-500">
              {twitter && (
                <a
                  class={linkClass}
                  href={`https://twitter.com/${twitter}`}
                  target="_blank"
                  rel="noreferrer nofollow"
                  aria-label="Twitter"
                >
                  <Icon icon={faTwitter} />
                </a>
              )}
              {instagram && (
                <a
                  class={linkClass}
                  href={`https://www.instagram.com/${instagram}`}
                  target="_blank"
                  rel="noreferrer nofollow"
                  aria-label="Instagram"
                >
                  <Icon icon={faInstagram} />
                </a>
              )}
              {youtube && (
                <a
                  class={linkClass}
                  href={`https://www.youtube.com/${youtube}`}
                  target="_blank"
                  rel="noreferrer nofollow"
                  aria-label="YouTube"
                >
                  <Icon icon={faYoutube} />
                </a>
              )}
              {github && (
                <a
                  class={linkClass}
                  href={`https://github.com/${github}`}
                  target="_blank"
                  rel="noreferrer nofollow"
                  aria-label="GitHub"
                >
                  <Icon icon={faGithub} />
                </a>
              )}
              {linkedin && (
                <a
                  class={linkClass}
                  href={`https://www.linkedin.com/company/${linkedin}`}
                  target="_blank"
                  rel="noreferrer nofollow"
                  aria-label="LinkedIn"
                >
                  <Icon icon={faLinkedin} />
                </a>
              )}
              <a
                href="/rss.xml"
                class={linkClass}
                type="application/rss+xml"
                rel="alternate nofollow"
                aria-label="RSS"
              >
                <Icon icon={faRss} />
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
