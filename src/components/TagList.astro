---
import { tagUrl } from '../lib/content'

interface Props {
  tags: string[]
  class?: string
}

const { tags, class: className } = Astro.props
---

{tags.length > 0 && (
  <div class={className}>
    {tags.map(tag => (
      <a
        href={tagUrl(tag)}
        class="inline-block bg-gray-200 px-4 py-2 text-sm text-gray-700 mr-2 mb-2"
      >
        {tag}
      </a>
    ))}
  </div>
)}
