---
import type { ImageMetadata } from 'astro'

import OptimizedImage from './OptimizedImage.astro'

interface Props {
  name: string
  description: string
  image?: ImageMetadata
  slug: string
}

const { name, description, image, slug } = Astro.props
---

<div class="max-w-sm rounded overflow-hidden">
  {image && (
    <a href={slug}>
      <OptimizedImage
        src={image}
        alt={name}
        title={name}
        width={384}
        class="w-full"
      />
    </a>
  )}
  <a href={slug}>
    <div class="py-2">
      <h3 class="font-bold text-xl mb-2">{name}</h3>
      <p class="text-gray-700 text-lg">{description}</p>
    </div>
  </a>
</div>
